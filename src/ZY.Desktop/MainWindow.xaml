<Window x:Class="ZY.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZY - Assistente Pessoal"
        Height="650"
        Width="950"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#131E30"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="ZY"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#54D9FF"/>

                <TextBlock Text="Assistente pessoal local"
                           FontSize="13"
                           Foreground="#94A3B8"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Histórico de mensagens -->
        <Border Grid.Row="1"
                Background="#111B2B"
                CornerRadius="12"
                Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel">

                    <Border Background="#1B2C42"
                            CornerRadius="10"
                            Padding="14"
                            HorizontalAlignment="Left"
                            MaxWidth="600">

                        <TextBlock Text="Olá! Estou pronto para conversar. Como posso ajudar?"
                                   Foreground="#E2E8F0"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Campo de mensagem -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput"
                     Grid.Column="0"
                     Height="48"
                     Padding="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Background="#172438"
                     Foreground="#FFFFFF"
                     BorderBrush="#263B56"
                     CaretBrush="#54D9FF"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Enviar"
                    Width="100"
                    Height="48"
                    Margin="12,0,0,0"
                    Background="#12618A"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
        </Grid>

    </Grid>
</Window>
