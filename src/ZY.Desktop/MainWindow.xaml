<Window x:Class="ZY.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZY | Assistente Pessoal"
        Height="780"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#070D19"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- PALETA -->
        <SolidColorBrush x:Key="PanelBrush"
                         Color="#0C1728"/>
        <SolidColorBrush x:Key="MutedBrush"
                         Color="#8298B5"/>
        <SolidColorBrush x:Key="TextBrush"
                         Color="#E8F4FF"/>

        <!-- PAINÉIS -->
        <Style x:Key="PanelStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush"
                    Value="#1A3450"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="20"/>
        </Style>

        <!-- BOTÃO -->
        <Style x:Key="SendButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#087FAE"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="18,0">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#109BCF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ANIMAÇÃO DO NÚCLEO E DAS ONDAS -->
        <Storyboard x:Key="ThinkingAuraAnimation">

            <!-- AURA EXTERNA -->
            <DoubleAnimation
                Storyboard.TargetName="BrainAura"
                Storyboard.TargetProperty="Opacity"
                From="0.10"
                To="0.48"
                Duration="0:0:1.1"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="BrainAura"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.88"
                To="1.15"
                Duration="0:0:1.1"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="BrainAura"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.88"
                To="1.15"
                Duration="0:0:1.1"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <!-- AURA INTERNA -->
            <DoubleAnimation
                Storyboard.TargetName="BrainAuraInner"
                Storyboard.TargetProperty="Opacity"
                From="0.12"
                To="0.42"
                Duration="0:0:0.75"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="BrainAuraInner"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.92"
                To="1.12"
                Duration="0:0:0.75"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="BrainAuraInner"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.92"
                To="1.12"
                Duration="0:0:0.75"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <!-- VISUALIZADOR DE ONDAS SONORAS -->

            <DoubleAnimation
                Storyboard.TargetName="WaveBar01"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.85"
                Duration="0:0:0.55"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar02"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.72"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar03"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.65"
                Duration="0:0:0.48"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar04"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.65"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar05"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.75"
                Duration="0:0:0.52"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar06"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.80"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar07"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.60"
                Duration="0:0:0.50"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar08"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.68"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar09"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.75"
                Duration="0:0:0.58"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar10"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.73"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar11"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.65"
                Duration="0:0:0.46"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar12"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.90"
                Duration="0:0:0.62"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar13"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.75"
                Duration="0:0:0.54"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar14"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="1.00"
                Duration="0:0:0.76"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="WaveBar15"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.25"
                To="0.65"
                Duration="0:0:0.51"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

        </Storyboard>

    </Window.Resources>

    <!-- FUNDO -->
    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0"
              Margin="5,0,5,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Border Width="34"
                        Height="34"
                        CornerRadius="10"
                        Background="#102E49"
                        BorderBrush="#23628A"
                        BorderThickness="1">

                    <TextBlock Text="Z"
                               Foreground="#72E4FF"
                               FontSize="21"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="11,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="ZY"
                               Foreground="#E8F7FF"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock Text="PERSONAL INTELLIGENCE"
                               Foreground="#607B99"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>

                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Ellipse Width="7"
                         Height="7"
                         Fill="#48DFA9"
                         Margin="0,0,8,0"/>

                <TextBlock Text="LOCAL SYSTEM"
                           Foreground="#8298B5"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>
        </Grid>

        <!-- CONTEÚDO -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.55*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL DO CÉREBRO -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Margin="0,0,12,0"
                    ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- IDENTIDADE -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">

                        <TextBlock Text="NÚCLEO DE ENERGIA"
                                   Foreground="#6385A6"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Sistema operacional do ZY"
                                   Foreground="#9BB0C9"
                                   FontSize="11"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CÉREBRO E VISUALIZADOR -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <!-- CÉREBRO HOLOGRÁFICO -->
                        <Grid x:Name="BrainCore"
                              Width="300"
                              Height="300">

                            <!-- AURA EXTERNA -->
                            <Ellipse x:Name="BrainAura"
                                     Width="245"
                                     Height="245"
                                     Fill="#123E70"
                                     Opacity="0.12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">

                                <Ellipse.Effect>
                                    <BlurEffect Radius="38"/>
                                </Ellipse.Effect>

                                <Ellipse.RenderTransform>
                                    <ScaleTransform CenterX="122.5"
                                                    CenterY="122.5"/>
                                </Ellipse.RenderTransform>

                            </Ellipse>

                            <!-- AURA INTERNA -->
                            <Ellipse x:Name="BrainAuraInner"
                                     Width="205"
                                     Height="205"
                                     Fill="#087DBD"
                                     Opacity="0.15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">

                                <Ellipse.Effect>
                                    <BlurEffect Radius="30"/>
                                </Ellipse.Effect>

                                <Ellipse.RenderTransform>
                                    <ScaleTransform CenterX="102.5"
                                                    CenterY="102.5"/>
                                </Ellipse.RenderTransform>

                            </Ellipse>

                            <!-- ILUSTRAÇÃO -->
                            <Viewbox Width="205"
                                     Height="190"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">

                                <Grid Width="300"
                                      Height="280">

                                    <!-- SILHUETA -->
                                    <Path Data="M150,55
                                                C132,40 105,47 95,65
                                                C70,62 54,84 59,106
                                                C39,122 48,151 66,160
                                                C61,184 82,202 103,198
                                                C114,219 139,218 150,203
                                                C161,218 186,219 197,198
                                                C218,202 239,184 234,160
                                                C252,151 261,122 241,106
                                                C246,84 230,62 205,65
                                                C195,47 168,40 150,55 Z"
                                          Stroke="#8DEEFF"
                                          StrokeThickness="3"
                                          StrokeLineJoin="Round"
                                          Opacity="0.95">

                                        <Path.Fill>
                                            <RadialGradientBrush
                                                Center="0.35,0.25"
                                                RadiusX="0.8"
                                                RadiusY="0.8">

                                                <GradientStop Color="#D8FAFF"
                                                              Offset="0"/>
                                                <GradientStop Color="#56DFFF"
                                                              Offset="0.2"/>
                                                <GradientStop Color="#167FC1"
                                                              Offset="0.58"/>
                                                <GradientStop Color="#082C59"
                                                              Offset="1"/>

                                            </RadialGradientBrush>
                                        </Path.Fill>

                                        <Path.Effect>
                                            <DropShadowEffect Color="#54DFFF"
                                                              BlurRadius="18"
                                                              ShadowDepth="0"
                                                              Opacity="0.35"/>
                                        </Path.Effect>

                                    </Path>

                                    <!-- DIVISÃO DOS HEMISFÉRIOS -->
                                    <Path Data="M150,57
                                                C143,85 158,103 148,126
                                                C140,149 158,170 150,205"
                                          Stroke="#C5F8FF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.8"/>

                                    <!-- DOBRAS ESQUERDAS -->
                                    <Path Data="M105,72 C83,82 89,105 108,111
                                                M72,119 C94,111 112,129 108,147
                                                M83,169 C105,151 123,164 124,187
                                                M120,65 C132,81 128,96 116,102"
                                          Stroke="#9CEEFF"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Opacity="0.65"/>

                                    <!-- DOBRAS DIREITAS -->
                                    <Path Data="M195,72 C217,82 211,105 192,111
                                                M228,119 C206,111 188,129 192,147
                                                M217,169 C195,151 177,164 176,187
                                                M180,65 C168,81 172,96 184,102"
                                          Stroke="#9CEEFF"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Opacity="0.65"/>

                                    <!-- PONTO CENTRAL -->
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#FFFFFF"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">

                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#54DFFF"
                                                              BlurRadius="18"
                                                              ShadowDepth="0"/>
                                        </Ellipse.Effect>

                                    </Ellipse>

                                </Grid>
                            </Viewbox>
                        </Grid>

                        <!-- VISUALIZADOR DE ONDAS -->
                        <StackPanel Margin="0,0,0,0"
                                    HorizontalAlignment="Center">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Height="42"
                                        VerticalAlignment="Center">

                                <!-- BARRA 01 -->
                                <Border x:Name="WaveBar01"
                                        Width="4"
                                        Height="17"
                                        Margin="3,0"
                                        Background="#278DCB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.65">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 02 -->
                                <Border x:Name="WaveBar02"
                                        Width="4"
                                        Height="29"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.7">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 03 -->
                                <Border x:Name="WaveBar03"
                                        Width="4"
                                        Height="20"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.75">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 04 -->
                                <Border x:Name="WaveBar04"
                                        Width="4"
                                        Height="35"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.85">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 05 -->
                                <Border x:Name="WaveBar05"
                                        Width="4"
                                        Height="23"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.8">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 06 -->
                                <Border x:Name="WaveBar06"
                                        Width="4"
                                        Height="38"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.9">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 07 -->
                                <Border x:Name="WaveBar07"
                                        Width="4"
                                        Height="19"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.8">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 08 -->
                                <Border x:Name="WaveBar08"
                                        Width="4"
                                        Height="40"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.95">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 09 -->
                                <Border x:Name="WaveBar09"
                                        Width="4"
                                        Height="25"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.8">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 10 -->
                                <Border x:Name="WaveBar10"
                                        Width="4"
                                        Height="34"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.9">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 11 -->
                                <Border x:Name="WaveBar11"
                                        Width="4"
                                        Height="19"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.75">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 12 -->
                                <Border x:Name="WaveBar12"
                                        Width="4"
                                        Height="32"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.85">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 13 -->
                                <Border x:Name="WaveBar13"
                                        Width="4"
                                        Height="23"
                                        Margin="3,0"
                                        Background="#54D9FF"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.8">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 14 -->
                                <Border x:Name="WaveBar14"
                                        Width="4"
                                        Height="36"
                                        Margin="3,0"
                                        Background="#38B9EB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.9">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- BARRA 15 -->
                                <Border x:Name="WaveBar15"
                                        Width="4"
                                        Height="17"
                                        Margin="3,0"
                                        Background="#278DCB"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="0.65">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.25"/>
                                    </Border.RenderTransform>
                                </Border>

                            </StackPanel>

                            <TextBlock Text="NEURAL FREQUENCY"
                                       Foreground="#456987"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- ESTADO -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,30">

                        <Border Background="#102A42"
                                BorderBrush="#205577"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="18,9">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse x:Name="AssistantStateIndicator"
                                         Width="7"
                                         Height="7"
                                         Fill="#54D9FF"
                                         Margin="0,0,9,0"
                                         VerticalAlignment="Center">

                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#54D9FF"
                                                          BlurRadius="9"
                                                          ShadowDepth="0"
                                                          Opacity="0.8"/>
                                    </Ellipse.Effect>

                                </Ellipse>

                                <TextBlock x:Name="AssistantStateText"
                                           Text="STANDBY"
                                           Foreground="#54D9FF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AssistantStateDescription"
                                   Text="AGUARDANDO INTERAÇÃO"
                                   Foreground="#536F8C"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- PAINEL DE CONVERSAÇÃO -->
            <Border Grid.Column="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="12,0,0,0">

                <Grid Margin="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Conversação"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="23"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Seu espaço de interação com o ZY"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#102A42"
                                CornerRadius="8"
                                Padding="12,7"
                                VerticalAlignment="Center">

                            <TextBlock Text="SESSÃO LOCAL"
                                       Foreground="#54D9FF"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                    <!-- HISTÓRICO -->
                    <Border Grid.Row="1"
                            Background="#091423"
                            BorderBrush="#172D46"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">


                        <ScrollViewer x:Name="MessagesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}">
                                    <Setter Property="Width"
                                            Value="8"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#315A78"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <Grid Width="8"
                                                      Background="Transparent">

                                                    <Track x:Name="PART_Track"
                                                           IsDirectionReversed="True">

                                                        <Track.Thumb>
                                                            <Thumb MinHeight="28"
                                                                   Background="#315A78">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                        <Border x:Name="ThumbBorder"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Margin="1,2"/>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                     Value="True">
                                                                                <Setter TargetName="ThumbBorder"
                                                                                        Property="Background"
                                                                                        Value="#54D9FF"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging"
                                                                                     Value="True">
                                                                                <Setter TargetName="ThumbBorder"
                                                                                        Property="Background"
                                                                                        Value="#109BCF"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>

                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>

                            <StackPanel x:Name="MessagesPanel">
                                <!-- Preserve aqui o conteúdo inicial atual do ZY -->
                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                    <!-- ENVIO -->
                    <Grid Grid.Row="2"
                          Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#101F33"
                                BorderBrush="#29445F"
                                BorderThickness="1"
                                CornerRadius="11"
                                Height="52">

                            <Grid>
                                <TextBox x:Name="MessageInput"
                                         Background="Transparent"
                                         Foreground="#FFFFFF"
                                         BorderThickness="0"
                                         Padding="15,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         CaretBrush="#54D9FF"/>

                                <TextBlock x:Name="MessagePlaceholder"
                                           Text="Digite sua mensagem para o ZY..."
                                           Foreground="#607B99"
                                           FontSize="13"
                                           Margin="15,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>

                        </Border>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Enviar"
                                Width="100"
                                Height="52"
                                Margin="12,0,0,0"
                                Style="{StaticResource SendButtonStyle}"/>

                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Grid>

</Window>
