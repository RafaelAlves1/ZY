<Window x:Class="ZY.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZY | Assistente Pessoal"
        Height="780"
        Width="1440"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- PALETA -->
        <SolidColorBrush x:Key="BackgroundBrush"
                Color="#141414"/>
        <SolidColorBrush x:Key="SidebarBrush"
                Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SurfaceBrush"
                Color="#242424"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush"
                Color="#292929"/>
        <SolidColorBrush x:Key="BorderBrush"
                Color="#363636"/>
        <SolidColorBrush x:Key="TextBrush"
                Color="#EAEAEA"/>
        <SolidColorBrush x:Key="MutedBrush"
                Color="#999999"/>
        <SolidColorBrush x:Key="AccentBrush"
                Color="#1677FF"/>


        <!-- BOTÃO ENVIAR - PALETA GRAFITE -->
        <Style x:Key="SendButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#303030"/>
            <Setter Property="Foreground"
                    Value="#EAEAEA"/>
            <Setter Property="BorderBrush"
                    Value="#414141"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A3A"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#505050"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252525"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BOTÕES DE ÍCONE -->
        <Style x:Key="IconButtonStyle"
                TargetType="Button">
            <Setter Property="Width"
                    Value="42"/>
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Background"
                    Value="#292929"/>
            <Setter Property="Foreground"
                    Value="#EAEAEA"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO DA SIDEBAR -->
        <Style x:Key="SidebarActionButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#303030"/>
            <Setter Property="Foreground"
                    Value="#EAEAEA"/>
            <Setter Property="BorderBrush"
                    Value="#414141"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A3A"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#505050"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252525"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO DE AÇÃO DO CABEÇALHO -->
        <Style x:Key="HeaderTextButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#999999"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#292929"/>
                                <Setter Property="Foreground"
                                        Value="#EAEAEA"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#363636"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ANIMAÇÃO DO CÉREBRO E DAS ONDAS -->
        <Storyboard x:Key="ThinkingAuraAnimation">

            <DoubleAnimation Storyboard.TargetName="BrainAura"
                             Storyboard.TargetProperty="Opacity"
                             From="0.10"
                    To="0.48"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="BrainAura"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.88"
                    To="1.15"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="BrainAura"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.88"
                    To="1.15"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="BrainAuraInner"
                             Storyboard.TargetProperty="Opacity"
                             From="0.12"
                    To="0.42"
                             Duration="0:0:0.75"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="BrainAuraInner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92"
                    To="1.12"
                             Duration="0:0:0.75"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="BrainAuraInner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92"
                    To="1.12"
                             Duration="0:0:0.75"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="WaveBar01"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.85"
                    Duration="0:0:0.55"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar02"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.72"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar03"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.65"
                    Duration="0:0:0.48"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar04"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.65"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar05"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.75"
                    Duration="0:0:0.52"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar06"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.80"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar07"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.60"
                    Duration="0:0:0.50"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar08"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.68"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar09"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.75"
                    Duration="0:0:0.58"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar10"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.73"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar11"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.65"
                    Duration="0:0:0.46"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar12"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.90"
                    Duration="0:0:0.62"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar13"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.75"
                    Duration="0:0:0.54"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar14"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="1.00"
                    Duration="0:0:0.76"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar15"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    From="0.25"
                    To="0.65"
                    Duration="0:0:0.51"
                    AutoReverse="True"
                    RepeatBehavior="Forever"/>

        </Storyboard>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- IDENTIDADE -->
                <Grid Grid.Row="0"
                        Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="#303030">
                        <TextBlock Text="Z"
                                   Foreground="#EAEAEA"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="ZY"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock Text="PERSONAL INTELLIGENCE"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- NOVA CONVERSA -->
                <Button Grid.Row="1"
                        Style="{StaticResource SidebarActionButton}"
                        Height="42"
                        Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Margin="0,0,10,0"
                                   FontSize="13"/>
                        <TextBlock Text="Nova conversa"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- HISTÓRICO -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="CONVERSAS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="3,0,0,12"/>

                    <TextBlock Text="O histórico aparecerá aqui."
                               Foreground="#777777"
                               FontSize="11"
                               Margin="3,0,0,0"/>
                </StackPanel>

                <!-- RODAPÉ -->
                <Border Grid.Row="3"
                        BorderBrush="#363636"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#48DFA9"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="LOCAL SYSTEM"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            ToolTip="Recolher ou expandir sidebar">
                        <TextBlock Text="&#xE700;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <TextBlock Text="Conversação"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Seu espaço de interação com o ZY"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button x:Name="ClearConversationButton"
                            Grid.Column="2"
                            Style="{StaticResource HeaderTextButton}"
                            Height="34"
                            Padding="12,0"
                            ToolTip="Limpar histórico da conversa">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="Limpar conversa"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CHAT -->
            <Grid Grid.Row="1"
                    Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HISTÓRICO -->
                <ScrollViewer x:Name="MessagesScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width"
                                    Value="8"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Width="8"
                                                Background="Transparent">
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb MinHeight="28"
                                                           Background="#454545">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Margin="1,2"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver"
                                                                            Value="True">
                                                                        <Setter TargetName="ThumbBorder"
                                                                                Property="Background"
                                                                                Value="#777777"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel x:Name="MessagesPanel"
                                MaxWidth="900"
                                HorizontalAlignment="Center"
                                Margin="10,20"/>
                </ScrollViewer>

                <!-- ÁREA DE ENVIO -->
                <StackPanel Grid.Row="1"
                            MaxWidth="900"
                            HorizontalAlignment="Center"
                            Width="900"
                            Margin="0,18,0,0">

                    <Border Background="#202020"
                            BorderBrush="#393939"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="MessageInput"
                                     Grid.Row="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     Padding="5,4"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="38"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     CaretBrush="#FFFFFF"/>

                            <TextBlock x:Name="MessagePlaceholder"
                                       Grid.Row="0"
                                       Text="Envie uma mensagem ao ZY..."
                                       Foreground="#777777"
                                       FontSize="13"
                                       Margin="5,4,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Top"/>

                            <Grid Grid.Row="1"
                                    Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ZY · EXECUÇÃO LOCAL"
                                           Foreground="#777777"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0"/>

                                <!-- MICROFONE -->
                                <Button x:Name="VoiceButton"
                                        Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,8,0"
                                        ToolTip="Iniciar conversa por voz">
                                    <TextBlock Text="&#xE720;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"/>
                                </Button>

                                <!-- ENVIAR -->
                                <Button x:Name="SendButton"
                                        Grid.Column="2"
                                        Content="Enviar"
                                        Width="90"
                                        Height="36"
                                        Style="{StaticResource SendButtonStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="O ZY pode cometer erros. Verifique informações importantes."
                               Foreground="#666666"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- MODO DE VOZ -->
        <Grid x:Name="VoiceModePanel"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="#141414">

            <Border Background="#1F1F1F"
                    BorderBrush="#363636"
                    BorderThickness="1"
                    CornerRadius="18"
                    Margin="40">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="CloseVoiceButton"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            Margin="20"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Voltar ao chat">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"/>
                    </Button>

                    <!-- CÉREBRO -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="ZY"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="NÚCLEO DE VOZ"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <Grid x:Name="BrainCore"
                              Width="420"
                              Height="420">

                            <Ellipse x:Name="BrainAura"
                                     Width="340"
                                     Height="340"
                                     Fill="#123E70"
                                     Opacity="0.12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="38"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform CenterX="170"
                                            CenterY="170"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse x:Name="BrainAuraInner"
                                     Width="285"
                                     Height="285"
                                     Fill="#087DBD"
                                     Opacity="0.15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
