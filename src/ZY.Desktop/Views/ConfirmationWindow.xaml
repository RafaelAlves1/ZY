<Window x:Class="ZY.Desktop.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZY | Confirmação"
        Width="440"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Border Background="#0B1422"
            BorderBrush="#24415D"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        Background="#142D45"
                        CornerRadius="9"
                        VerticalAlignment="Center">

                    <TextBlock Text="&#xE9CE;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#54D9FF"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="Confirmar limpeza"
                           Foreground="#E2EAF3"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <Border Grid.Column="2"
                        Background="#142D45"
                        CornerRadius="7"
                        Padding="10,0"
                        Height="25"
                        VerticalAlignment="Center">

                    <TextBlock Text="CONFIRMAÇÃO"
                               Foreground="#54D9FF"
                               FontSize="9"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- CONTEÚDO -->
            <Grid Grid.Row="1"
                  Margin="0,22,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="44"
                        Height="44"
                        Background="#35232F"
                        CornerRadius="11"
                        VerticalAlignment="Top">

                    <TextBlock Text="&#xE74D;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#E58B98"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">

                    <TextBlock x:Name="TitleText"
                               Text="Limpar conversa?"
                               Foreground="#EAF2FA"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBlock x:Name="MessageText"
                               Text="Essa ação apagará as mensagens exibidas e o histórico utilizado pela IA."
                               Foreground="#9BAFC5"
                               FontSize="11"
                               TextWrapping="Wrap"
                               LineHeight="17"/>
                </StackPanel>
            </Grid>

            <!-- AÇÕES -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Content="CANCELAR"
                        Width="105"
                        Height="34"
                        Margin="0,0,9,0"
                        Background="#17263A"
                        Foreground="#A8BED3"
                        BorderThickness="0"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="CancelButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#203A55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="ConfirmButton"
                        Content="LIMPAR CONVERSA"
                        Width="135"
                        Height="34"
                        Background="#49303B"
                        Foreground="#FFADB7"
                        BorderThickness="0"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="ConfirmButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#5A3946"/>
                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#684352"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
